# ============================================================
# Azure AI Foundry — Kimi K2.6 (chat-completions capable model
# deployed as a Serverless API / Model-as-a-Service endpoint)
# ============================================================
# The Model Inference API root works directly:
#   https://<your-resource-name>.services.ai.azure.com/models
# A Foundry *project* endpoint also works -- it's auto-normalized:
#   https://<your-resource-name>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/models
AZURE_FOUNDRY_API_KEY=your-azure-ai-foundry-api-key
# Deployment / model name as configured in the Foundry project
AZURE_FOUNDRY_MODEL=Kimi-K2.6
# Optional. Only needed if your endpoint requires an explicit api-version.
AZURE_FOUNDRY_API_VERSION=

# LLM behavior. Kimi K2.6 is a reasoning model -- it spends tokens on a
# hidden chain-of-thought before its final answer, so max_tokens needs real
# headroom (too low => truncated/empty responses). Reasoning calls can also
# take a while, hence the generous request timeout.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
AZURE_FOUNDRY_REQUEST_TIMEOUT_SECONDS=120

# Default provider used by backend callers that do not pass an explicit
# selection. The Streamlit sidebar can switch providers per question.
# Supported values: azure_foundry, ollama, openrouter, nvidia_nim
LLM_DEFAULT_PROVIDER=azure_foundry

# ============================================================
# Ollama — locally downloaded models
# ============================================================
# Streamlit starts a local Ollama server automatically when it is not already
# running. The sidebar discovers downloaded models and lets the user select one.
OLLAMA_BASE_URL=http://localhost:11434
# Set false to manage the Ollama server yourself.
OLLAMA_AUTO_START=true
# Optional explicit executable path if Ollama is not on PATH or in a standard
# installation directory.
OLLAMA_EXECUTABLE=
OLLAMA_STARTUP_TIMEOUT_SECONDS=20
# Stop Ollama when Streamlit exits only if this app started the process.
OLLAMA_STOP_ON_EXIT=true
# Optional backend default. The UI uses the model selected in the sidebar.
OLLAMA_MODEL=
OLLAMA_DISCOVERY_TIMEOUT_SECONDS=3
OLLAMA_REQUEST_TIMEOUT_SECONDS=300

# ============================================================
# OpenRouter - hosted models through an OpenAI-compatible API
# ============================================================
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# This free reasoning/code model is shown in the Streamlit model selector.
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_REASONING_ENABLED=true
# Metadata refresh timeout for the public OpenRouter model catalog shown in UI.
OPENROUTER_DISCOVERY_TIMEOUT_SECONDS=8
OPENROUTER_REQUEST_TIMEOUT_SECONDS=180
# Retry transient HTTP 429/5xx/timeout failures once before showing an error.
OPENROUTER_MAX_RETRIES=1
OPENROUTER_RETRY_BACKOFF_SECONDS=1.5
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=AI Analyst

# ============================================================
# NVIDIA API Catalog / NIM - OpenAI-compatible cloud endpoint
# ============================================================
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# The UI intentionally exposes only models explicitly approved for this app:
#   nvidia/nemotron-3-ultra-550b-a55b
#   poolside/laguna-xs-2.1
#   z-ai/glm-5.2
#   minimaxai/minimax-m3
# Laguna, GLM, and MiniMax use the exact per-model profiles supplied in their
# NVIDIA examples. Nemotron-only reasoning controls are not sent to them.
# Defaults below follow NVIDIA's Nemotron 3 Ultra API example.
NVIDIA_NIM_TEMPERATURE=1
NVIDIA_NIM_TOP_P=0.95
NVIDIA_NIM_MAX_TOKENS=16384
NVIDIA_NIM_REASONING_ENABLED=true
NVIDIA_NIM_REASONING_BUDGET=16384
NVIDIA_NIM_REQUEST_TIMEOUT_SECONDS=300
NVIDIA_NIM_DISCOVERY_TIMEOUT_SECONDS=8
NVIDIA_NIM_MAX_RETRIES=2
NVIDIA_NIM_RETRY_BACKOFF_SECONDS=1.5
# Shared rolling-window gate for discovery, chat, retries, models, and sessions.
NVIDIA_NIM_REQUESTS_PER_MINUTE=60
NVIDIA_NIM_RATE_LIMIT_WINDOW_SECONDS=60
# Slightly over one second keeps normal traffic below the 60 RPM boundary.
NVIDIA_NIM_MIN_REQUEST_INTERVAL_SECONDS=1.05
NVIDIA_NIM_RATE_LIMIT_MAX_WAIT_SECONDS=120
# Used when NVIDIA returns 429 without a Retry-After header.
NVIDIA_NIM_429_COOLDOWN_SECONDS=60

# ============================================================
# Official filesystem MCP server
# ============================================================
MCP_FILESYSTEM_ENABLED=true
# Defaults to this project root when empty. Use the OS path separator for
# multiple roots (semicolon on Windows, colon on Linux/macOS).
MCP_FILESYSTEM_ROOTS=
MCP_FILESYSTEM_PACKAGE=@modelcontextprotocol/server-filesystem
# Read-only by default. Setting this true makes interactive mutation tools
# available; interactive requests still require explicit confirmation in Streamlit.
# Database preparation also uses the official MCP write_file tool for its exact,
# backend-managed knowledge documents when this is true. Delete is always blocked.
MCP_FILESYSTEM_ALLOW_MUTATIONS=false
MCP_FILESYSTEM_MAX_TOOL_ROUNDS=8
MCP_FILESYSTEM_MAX_RESULT_CHARS=30000
MCP_FILESYSTEM_OPERATION_TIMEOUT_SECONDS=90

# ============================================================
# Database
# ============================================================
# Path to the SQLite analytics database (packaged sample data lives in ./data)
AI_ANALYST_DB_PATH=data/ai_analyst.db

# ============================================================
# Metadata store
# ============================================================
AI_ANALYST_METADATA_DIR=metadata_store
# Describe up to this many newly discovered tables in one LLM request.
METADATA_LLM_ENRICH_BATCH_SIZE=12

# ============================================================
# Vector knowledge base (RAG-based schema retrieval)
# ============================================================
# Versioned local Chroma collections are kept per connected database. Chroma
# 1.5+ supports Windows/Python 3.13; embeddings run entirely on-machine through
# its bundled ONNX MiniLM model after the one-time model download.
VECTOR_STORE_DIR=vector_store
# Max tables returned by a similarity search before foreign-key expansion.
VECTOR_TOP_K=6
# Set false to always use the keyword/lexical retrieval fallback instead.
VECTOR_RAG_ENABLED=true

# ============================================================
# Query / execution limits
# ============================================================
SQL_MAX_ROWS=5000
# The UI/analysis window uses SQL_MAX_ROWS. CSV export reruns the same validated,
# read-only query only after the user clicks Prepare complete CSV, up to this cap.
SQL_DOWNLOAD_MAX_ROWS=250000
SQL_STATEMENT_TIMEOUT_SECONDS=15
SQL_MAX_RETRIES=2

# Number of rows rendered in the table. CSV downloads are not limited by this.
UI_PREVIEW_ROWS=200

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/ai_analyst.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
# Structured, secret-redacted agent/tool/provider events (JSON Lines).
AGENT_TRACE_FILE=logs/agent_traces.jsonl
AGENT_TRACE_MAX_BYTES=10000000
AGENT_TRACE_BACKUP_COUNT=5
AGENT_TRACE_MEMORY_EVENTS=1000
