# ============================================================
# Azure AI Foundry — Kimi K2.6 (chat-completions capable model
# deployed as a Serverless API / Model-as-a-Service endpoint)
# ============================================================
# The Model Inference API root works directly:
#   https://<your-resource-name>.services.ai.azure.com/models
# A Foundry *project* endpoint also works -- it's auto-normalized:
#   https://<your-resource-name>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/models
AZURE_FOUNDRY_API_KEY=your-azure-ai-foundry-api-key
# Deployment / model name as configured in the Foundry project
AZURE_FOUNDRY_MODEL=Kimi-K2.6
# Optional. Only needed if your endpoint requires an explicit api-version.
AZURE_FOUNDRY_API_VERSION=

# LLM behavior. Kimi K2.6 is a reasoning model -- it spends tokens on a
# hidden chain-of-thought before its final answer, so max_tokens needs real
# headroom (too low => truncated/empty responses). Reasoning calls can also
# take a while, hence the generous request timeout.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
AZURE_FOUNDRY_REQUEST_TIMEOUT_SECONDS=120

# Default provider used by backend callers that do not pass an explicit
# selection. The Streamlit sidebar can switch providers per question.
# Supported values: azure_foundry, ollama, openrouter
LLM_DEFAULT_PROVIDER=azure_foundry

# ============================================================
# Ollama — locally downloaded models
# ============================================================
# Streamlit starts a local Ollama server automatically when it is not already
# running. The sidebar discovers downloaded models and lets the user select one.
OLLAMA_BASE_URL=http://localhost:11434
# Set false to manage the Ollama server yourself.
OLLAMA_AUTO_START=true
# Optional explicit executable path if Ollama is not on PATH or in a standard
# installation directory.
OLLAMA_EXECUTABLE=
OLLAMA_STARTUP_TIMEOUT_SECONDS=20
# Stop Ollama when Streamlit exits only if this app started the process.
OLLAMA_STOP_ON_EXIT=true
# Optional backend default. The UI uses the model selected in the sidebar.
OLLAMA_MODEL=
OLLAMA_DISCOVERY_TIMEOUT_SECONDS=3
OLLAMA_REQUEST_TIMEOUT_SECONDS=300

# ============================================================
# OpenRouter - hosted models through an OpenAI-compatible API
# ============================================================
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# This free reasoning/code model is shown in the Streamlit model selector.
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_REQUEST_TIMEOUT_SECONDS=180
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=AI Analyst

# ============================================================
# Database
# ============================================================
# Path to the SQLite analytics database (packaged sample data lives in ./data)
AI_ANALYST_DB_PATH=data/ai_analyst.db

# ============================================================
# Metadata store
# ============================================================
AI_ANALYST_METADATA_DIR=metadata_store

# ============================================================
# Vector knowledge base (RAG-based schema retrieval)
# ============================================================
# One local Chroma collection is kept per connected database. Embeddings run
# entirely on-machine (Chroma's bundled ONNX MiniLM model) -- no API key, no
# per-query LLM token cost.
VECTOR_STORE_DIR=vector_store
# Max tables returned by a similarity search before foreign-key expansion.
VECTOR_TOP_K=6
# Set false to always use the keyword/lexical retrieval fallback instead.
VECTOR_RAG_ENABLED=true

# ============================================================
# Query / execution limits
# ============================================================
SQL_MAX_ROWS=5000
# The UI/LLM uses SQL_MAX_ROWS, while CSV export reruns the same validated,
# read-only query up to this larger safety cap.
SQL_DOWNLOAD_MAX_ROWS=250000
SQL_STATEMENT_TIMEOUT_SECONDS=15
SQL_MAX_RETRIES=2

# Number of rows rendered in the table. CSV downloads are not limited by this.
UI_PREVIEW_ROWS=200

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/ai_analyst.log
